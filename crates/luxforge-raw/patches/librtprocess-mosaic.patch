+// Luxforge: where a tile reads its input sites. The float rows are read in
+// place, at the frame's row stride. The sensor sites are first written,
+// through rpNormalizedSite, into a tile of the sites within three of the
+// tile's own, which the hexagon offsets then address at the tile's stride: no
+// read below goes further from the site it interpolates (the offsets are
+// checked against that reach once they are built). Tiles start three sites
+// inside the frame and end at least three before its far edges, so the input
+// tile holds only sensor sites. It borrows the start of the derivative
+// scratch, which a tile writes only after its last input read and reads only
+// where it has written it, so no tile reads another's input or derivatives.
+template <typename Input> struct MarkInput;
+
+template <> struct MarkInput<const float * const *> {
+    const float * const *rows;
+    MarkInput(const float * const *rows, float *) : rows(rows) {}
+    static int stride(int width) { return width; }
+    static bool covers(int) { return true; }
+    void load(int, int, int, int) {}
+    const float *at(int row, int col) const { return &rows[row][col]; }
+};
+
+template <> struct MarkInput<rpMosaicSites> {
+    static constexpr int reach = 3;
+    static constexpr int side = ts + 2 * reach;
+    const rpMosaicSites &sites;
+    float *tile;
+    int top = 0, left = 0;
+    MarkInput(const rpMosaicSites &sites, float *tile) : sites(sites), tile(tile) {}
+    static int stride(int) { return side; }
+    static bool covers(int distance) { return distance <= reach; }
+    // The sites from `reach` before the tile's first row and column to `reach`
+    // past its last, `bottom` and `right` exclusive.
+    void load(int tileTop, int tileLeft, int bottom, int right)
+    {
+        top = tileTop - reach;
+        left = tileLeft - reach;
+        for (int row = top; row < bottom + reach; row++) {
+            const rpMosaicSites::Row in = sites[row];
+            float *out = tile + (row - top) * side;
+            unsigned site = unsigned(left) % in.periodWidth;
+            for (int col = left; col < right + reach; col++) {
+                out[col - left] = rpNormalizedSite(in.samples[col], in.black[site], in.scale[site], in.gain[site]);
+                site = site + 1 == in.periodWidth ? 0 : site + 1;
+            }
+        }
+    }
+    const float *at(int row, int col) const { return tile + (row - top) * side + (col - left); }
+};
