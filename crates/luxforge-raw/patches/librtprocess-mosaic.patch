+// Luxforge's sensor-site input. RCD, Markesteijn and the border passes take
+// either the normalized float rows or the retained u16 mosaic with the
+// per-site tables the float rows were normalized with, and read every site
+// through rpNormalizedSite, the float rows' own expression, so each value they
+// interpolate is the same float.
+inline float rpNormalizedSite(uint16_t sample, float black, float scale, float gain)
+{
+    // `((sample - black) * scale) * gain` in float, in that order, as
+    // crates/luxforge-raw/src/normalize.rs writes the float rows.
+    float value = ((float(sample) - black) * scale) * gain;
+#if defined(__GNUC__) && !defined(__clang__)
+    // GCC contracts across statements and inlined calls by default
+    // (-ffp-contract=fast), so it could fuse this multiply into a caller's
+    // add, where the float rows' value was rounded and stored first. The empty
+    // asm, which emits no instruction, hands the caller the rounded value.
+    // Clang contracts only within one expression, so it needs none.
+#   if defined(__aarch64__)
+    __asm__("" : "+w"(value));
+#   elif defined(__SSE_MATH__)
+    __asm__("" : "+x"(value));
+#   else
+    __asm__("" : "+m"(value));
+#   endif
+#endif
+    return value;
+}
+// The u16 mosaic, `width` sites a row, and the black level, white scale and
+// gain of every site of one period of the CFA and black patterns, anchored at
+// sensor (0, 0): site (row, col) uses entry (row % periodHeight) * periodWidth
+// + col % periodWidth. `rawData[row][col]` is that site's normalized value.
+struct rpMosaicSites {
+    const uint16_t *samples;
+    size_t width;
+    const float *black, *scale, *gain;
+    unsigned periodWidth, periodHeight;
+
+    struct Row {
+        const uint16_t *samples;
+        const float *black, *scale, *gain;
+        unsigned periodWidth;
+
+        float operator[](int col) const
+        {
+            const unsigned site = unsigned(col) % periodWidth;
+            return rpNormalizedSite(samples[col], black[site], scale[site], gain[site]);
+        }
+    };
+
+    Row operator[](int row) const
+    {
+        const size_t period = size_t(unsigned(row) % periodHeight) * periodWidth;
+        return {samples + size_t(row) * width, black + period, scale + period, gain + period, periodWidth};
+    }
+};
