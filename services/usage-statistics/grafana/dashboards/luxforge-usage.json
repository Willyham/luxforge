    {
      "id": 15,
      "type": "table",
      "title": "Tool commits",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "luxforge-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT tool, count() AS commits, uniqExact(session_id) AS sessions, uniqExact(installation_id) AS installations,\n       uniqExact(image) AS images\nFROM luxforge.events_unique WHERE name = 'tool.commit' AND $__timeFilter(received_at) GROUP BY tool ORDER BY commits DESC",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
