          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(active_ms) / 3600000 AS hours FROM luxforge.session_summary WHERE $__timeFilter(first_received)",
          "refId": "A",
          "pluginVersion": "4.22.1"
