      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "luxforge-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(first_received) AS time, sum(active_ms) / 3600000 AS \"active hours\", count() AS sessions\nFROM luxforge.session_summary WHERE $__timeFilter(first_received) GROUP BY time ORDER BY time",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
