    {
      "id": 16,
      "type": "table",
      "title": "Operation outcomes and duration",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "luxforge-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT operation, outcome, count() AS operations, uniqExact(session_id) AS sessions,\n       round(quantileExactInclusive(0.5)(duration_ms)) AS \"p50 ms\", round(quantileExactInclusive(0.95)(duration_ms)) AS \"p95 ms\",\n       max(duration_ms) AS \"max ms\"\nFROM luxforge.events_unique WHERE name = 'operation.end' AND $__timeFilter(received_at) GROUP BY operation, outcome ORDER BY operation, outcome",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Sessions by release and operating system",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
