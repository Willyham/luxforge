          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT s.app AS app, s.os AS os, count() AS sessions, uniqExact(s.installation_id) AS installations\nFROM luxforge.session_summary AS s WHERE $__timeFilter(s.first_received) GROUP BY app, os ORDER BY sessions DESC",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
