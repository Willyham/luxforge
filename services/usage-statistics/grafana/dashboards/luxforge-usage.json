    {
      "id": 10,
      "type": "stat",
      "title": "Active time, hours (reported sessions)",
      "description": "Visible and not idle, derived from `app.presented` and `app.idle` events. A session counts from launch to its last received event; time after that is unknown and not counted.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
