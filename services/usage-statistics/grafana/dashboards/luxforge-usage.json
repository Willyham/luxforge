    {
      "id": 14,
      "type": "table",
      "title": "Feature use (interaction events)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "luxforge-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT feature, count() AS events, uniqExact(session_id) AS sessions, uniqExact(installation_id) AS installations\nFROM luxforge.events_unique WHERE name = 'interaction' AND $__timeFilter(received_at) GROUP BY feature ORDER BY events DESC",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
