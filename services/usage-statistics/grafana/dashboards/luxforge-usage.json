    {
      "id": 12,
      "type": "timeseries",
      "title": "Images added and exported per day",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "luxforge-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(received_at) AS time,\n       sumIf(ifNull(count, 0), name = 'images.added') AS \"images added\",\n       sumIf(ifNull(count, 0), name = 'operation.end' AND operation = 'export' AND outcome = 'completed') AS \"images exported\"\nFROM luxforge.events_unique WHERE $__timeFilter(received_at) GROUP BY time ORDER BY time",
          "refId": "A",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Active hours per day",
      "description": "Each session is attributed to the day its first batch was received.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "luxforge-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
