# Copy to .env (gitignored) and replace every value before starting the stack. Each password is used
# by exactly one component; none is ever written to an image, a log or a repository file.
# Generate one with, for example:  openssl rand -base64 24 | tr -d '/+=' 

# ClickHouse users: init/administration (reachable only from inside its own container), Vector's
# insert-only writer, and Grafana's read-only reader.
LUXFORGE_CLICKHOUSE_ADMIN_PASSWORD=change-me-admin
LUXFORGE_CLICKHOUSE_WRITER_PASSWORD=change-me-writer
LUXFORGE_CLICKHOUSE_READER_PASSWORD=change-me-reader

# Grafana's single administrator. There is no anonymous access and no sign-up.
LUXFORGE_GRAFANA_ADMIN_USER=luxforge-admin
LUXFORGE_GRAFANA_ADMIN_PASSWORD=change-me-grafana

# The ingress, published on localhost only. 8080 is its default; change it if that is taken.
LUXFORGE_INGRESS_PORT=8080

# Per-installation limiter in the ingress: one batch per interval (seconds), with a burst. The
# desktop sends at most one batch a minute; the ingress default is 20 and 5. 0 turns the limiter off.
LUXFORGE_INGRESS_ID_INTERVAL_SECS=20
LUXFORGE_INGRESS_ID_BURST=5
